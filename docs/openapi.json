{
  "openapi": "3.1.0",
  "info": {
    "title": "Hark HTTP API",
    "version": "1",
    "summary": "Send iOS notifications, approval prompts, and Live Activities from webhooks and API clients.",
    "description": "OpenAPI definition for Hark. Each deployment has one owner. Sessions provide owner access, scoped API tokens provide software access, and webhook tokens identify services. See /docs.md for detailed behavior and examples.",
    "license": { "name": "MIT", "identifier": "MIT" }
  },
  "externalDocs": { "description": "Complete API contract and examples", "url": "/docs" },
  "servers": [{ "url": "/", "description": "This Hark deployment" }],
  "tags": [
    { "name": "Health" },
    { "name": "Authentication" },
    { "name": "Tokens" },
    { "name": "Services" },
    { "name": "Devices" },
    { "name": "Notifications" },
    { "name": "Interactions" },
    { "name": "Live Activities" },
    { "name": "Events" },
    { "name": "History" },
    { "name": "Webhooks" }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "tags": ["Health"], "summary": "Check instance readiness", "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": { "description": "The instance and database are ready.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "tags": ["Authentication"], "summary": "Exchange the owner password for a session", "operationId": "login",
        "security": [], "x-hark-auth": "public",
        "requestBody": { "$ref": "#/components/requestBodies/Login" },
        "responses": { "200": { "$ref": "#/components/responses/Login" }, "401": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "tags": ["Authentication"], "summary": "Invalidate the presented session or API token", "operationId": "logout",
        "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "x-hark-auth": "session_or_api_token",
        "responses": { "204": { "description": "Credential invalidated." }, "401": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/auth/session": {
      "get": {
        "tags": ["Authentication"], "summary": "Describe the current authenticated user and credential", "operationId": "getCurrentSession",
        "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "x-hark-auth": "session_or_api_token",
        "responses": { "200": { "$ref": "#/components/responses/JSONDocument" }, "401": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/auth/password": {
      "post": {
        "tags": ["Authentication"], "summary": "Change the owner password", "operationId": "changePassword",
        "security": [{ "sessionBearer": [] }, { "sessionCookie": [] }], "x-hark-auth": "session",
        "requestBody": { "$ref": "#/components/requestBodies/ChangePassword" },
        "responses": { "204": { "description": "Password changed; other sessions retired." }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/auth/device/code": {
      "post": {
        "tags": ["Authentication"], "summary": "Start a device authorization grant", "operationId": "createDeviceCode",
        "security": [], "x-hark-auth": "public",
        "requestBody": { "$ref": "#/components/requestBodies/DeviceCode" },
        "responses": { "201": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/auth/device/token": {
      "post": {
        "tags": ["Authentication"], "summary": "Poll a device authorization grant", "operationId": "pollDeviceToken",
        "security": [], "x-hark-auth": "device_code_in_body",
        "requestBody": { "$ref": "#/components/requestBodies/DeviceToken" },
        "responses": { "200": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/auth/device/requests/{user_code}": {
      "parameters": [{ "$ref": "#/components/parameters/UserCode" }],
      "get": {
        "tags": ["Authentication"], "summary": "Describe a device authorization request", "operationId": "getDeviceRequest",
        "security": [{ "sessionBearer": [] }, { "sessionCookie": [] }], "x-hark-auth": "session",
        "responses": { "200": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/auth/device/requests/{user_code}/approve": {
      "parameters": [{ "$ref": "#/components/parameters/UserCode" }],
      "post": {
        "tags": ["Authentication"], "summary": "Approve a device authorization request", "operationId": "approveDeviceRequest",
        "security": [{ "sessionBearer": [] }, { "sessionCookie": [] }], "x-hark-auth": "session",
        "responses": { "200": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/auth/device/requests/{user_code}/deny": {
      "parameters": [{ "$ref": "#/components/parameters/UserCode" }],
      "post": {
        "tags": ["Authentication"], "summary": "Deny a device authorization request", "operationId": "denyDeviceRequest",
        "security": [{ "sessionBearer": [] }, { "sessionCookie": [] }], "x-hark-auth": "session",
        "responses": { "200": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/tokens": {
      "get": {
        "tags": ["Tokens"], "summary": "List API tokens", "operationId": "listTokens",
        "security": [{ "sessionBearer": [] }, { "sessionCookie": [] }], "x-hark-auth": "session",
        "responses": { "200": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      },
      "post": {
        "tags": ["Tokens"], "summary": "Create an API token", "operationId": "createToken",
        "security": [{ "sessionBearer": [] }, { "sessionCookie": [] }], "x-hark-auth": "session",
        "requestBody": { "$ref": "#/components/requestBodies/CreateToken" },
        "responses": { "201": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/tokens/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/ID" }],
      "delete": {
        "tags": ["Tokens"], "summary": "Revoke an API token", "operationId": "revokeToken",
        "security": [{ "sessionBearer": [] }, { "sessionCookie": [] }], "x-hark-auth": "session",
        "responses": { "204": { "description": "Token revoked." }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/services": {
      "get": {
        "tags": ["Services"], "summary": "List webhook services", "operationId": "listServices",
        "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "x-hark-auth": "session_or_api_token", "x-hark-scopes": ["services:read"],
        "responses": { "200": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      },
      "post": {
        "tags": ["Services"], "summary": "Create a webhook service", "operationId": "createService",
        "security": [{ "sessionBearer": [] }, { "sessionCookie": [] }], "x-hark-auth": "session",
        "requestBody": { "$ref": "#/components/requestBodies/CreateService" },
        "responses": { "201": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/services/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/ID" }],
      "get": {
        "tags": ["Services"], "summary": "Get a webhook service", "operationId": "getService",
        "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "x-hark-auth": "session_or_api_token", "x-hark-scopes": ["services:read"],
        "responses": { "200": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      },
      "patch": {
        "tags": ["Services"], "summary": "Update a webhook service", "operationId": "updateService",
        "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "x-hark-auth": "session_or_api_token", "x-hark-scopes": ["services:write"],
        "requestBody": { "$ref": "#/components/requestBodies/UpdateService" },
        "responses": { "200": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      },
      "delete": {
        "tags": ["Services"], "summary": "Delete a webhook service", "operationId": "deleteService",
        "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "x-hark-auth": "session_or_api_token", "x-hark-scopes": ["services:write"],
        "responses": { "204": { "description": "Service deleted." }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/services/{id}/webhook-token": {
      "parameters": [{ "$ref": "#/components/parameters/ID" }],
      "post": {
        "tags": ["Services"], "summary": "Rotate a service webhook token", "operationId": "rotateServiceWebhookToken",
        "security": [{ "sessionBearer": [] }, { "sessionCookie": [] }], "x-hark-auth": "session",
        "responses": { "201": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/devices": {
      "get": {
        "tags": ["Devices"], "summary": "List registered devices", "operationId": "listDevices",
        "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "x-hark-auth": "session_or_api_token", "x-hark-scopes": ["devices:read"],
        "responses": { "200": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      },
      "post": {
        "tags": ["Devices"], "summary": "Register or refresh a device", "operationId": "registerDevice",
        "security": [{ "sessionBearer": [] }, { "sessionCookie": [] }], "x-hark-auth": "session",
        "requestBody": { "$ref": "#/components/requestBodies/RegisterDevice" },
        "responses": { "201": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/devices/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/ID" }],
      "get": {
        "tags": ["Devices"], "summary": "Get a registered device", "operationId": "getDevice",
        "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "x-hark-auth": "session_or_api_token", "x-hark-scopes": ["devices:read"],
        "responses": { "200": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      },
      "delete": {
        "tags": ["Devices"], "summary": "Unregister a device", "operationId": "deleteDevice",
        "security": [{ "sessionBearer": [] }, { "sessionCookie": [] }], "x-hark-auth": "session",
        "responses": { "204": { "description": "Device unregistered." }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/devices/{id}/push-to-start-token": {
      "parameters": [{ "$ref": "#/components/parameters/ID" }],
      "put": {
        "tags": ["Devices"], "summary": "Register a device push-to-start token", "operationId": "putPushToStartToken",
        "security": [{ "sessionBearer": [] }, { "sessionCookie": [] }], "x-hark-auth": "session",
        "requestBody": { "$ref": "#/components/requestBodies/PushToken" },
        "responses": { "204": { "description": "Token registered." }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/devices/{id}/activity-update-token": {
      "parameters": [{ "$ref": "#/components/parameters/ID" }],
      "put": {
        "tags": ["Devices"], "summary": "Register a Live Activity update token", "operationId": "putActivityUpdateToken",
        "security": [{ "sessionBearer": [] }, { "sessionCookie": [] }], "x-hark-auth": "session",
        "requestBody": { "$ref": "#/components/requestBodies/ActivityUpdateToken" },
        "responses": { "200": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/activity-deliveries/{id}/update-token": {
      "parameters": [{ "$ref": "#/components/parameters/ID" }],
      "put": {
        "tags": ["Devices"], "summary": "Register a delivery update token using its single-use credential", "operationId": "putDeliveryUpdateToken",
        "security": [], "x-hark-auth": "capability_in_body",
        "requestBody": { "$ref": "#/components/requestBodies/DeliveryUpdateToken" },
        "responses": { "204": { "description": "Token registered." }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/notifications": {
      "post": {
        "tags": ["Notifications"], "summary": "Send a notification", "operationId": "sendNotification",
        "security": [{ "apiToken": [] }], "x-hark-auth": "api_token", "x-hark-scopes": ["notifications:send"],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/Notification" },
        "responses": { "201": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/interactions": {
      "get": {
        "tags": ["Interactions"], "summary": "List interactions", "operationId": "listInteractions",
        "description": "A session lists all interactions in the account. An API token lists only interactions created by that token. Pagination also excludes interactions from other requesters.",
        "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "x-hark-auth": "session_or_api_token", "x-hark-scopes": ["interactions:read"],
        "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/Status" }],
        "responses": { "200": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      },
      "post": {
        "tags": ["Interactions"], "summary": "Send an approval, yes/no, or reply prompt", "operationId": "createInteraction",
        "security": [{ "apiToken": [] }], "x-hark-auth": "api_token", "x-hark-scopes": ["interactions:create", "notifications:send"],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/Interaction" },
        "responses": { "201": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/interactions/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/ID" }],
      "get": {
        "tags": ["Interactions"], "summary": "Get an interaction", "operationId": "getInteraction",
        "description": "A session can read any interaction in the account. An API token can read only interactions created by that token. Interactions from another requester return the same 404 not_found response as an unknown id, including during long polling.",
        "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "x-hark-auth": "session_or_api_token", "x-hark-scopes": ["interactions:read"],
        "responses": { "200": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/interactions/{id}/response": {
      "parameters": [{ "$ref": "#/components/parameters/ID" }],
      "post": {
        "tags": ["Interactions"], "summary": "Answer an interaction", "operationId": "respondToInteraction",
        "security": [{ "sessionBearer": [] }, { "sessionCookie": [] }, {}], "x-hark-auth": "session_or_response_token_in_body",
        "requestBody": { "$ref": "#/components/requestBodies/InteractionResponse" },
        "responses": { "200": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/interactions/{id}/cancel": {
      "parameters": [{ "$ref": "#/components/parameters/ID" }],
      "post": {
        "tags": ["Interactions"], "summary": "Cancel a pending interaction", "operationId": "cancelInteraction",
        "description": "A session can cancel any pending interaction in the account. An API token can cancel only interactions created by that token. Interactions from another requester return the same 404 not_found response as an unknown id and remain pending.",
        "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "x-hark-auth": "session_or_api_token", "x-hark-scopes": ["interactions:create"],
        "responses": { "200": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/activities": {
      "get": {
        "tags": ["Live Activities"], "summary": "List Live Activities", "operationId": "listActivities",
        "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "x-hark-auth": "session_or_api_token", "x-hark-scopes": ["activities:read"],
        "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/Status" }],
        "responses": { "200": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      },
      "post": {
        "tags": ["Live Activities"], "summary": "Start a Live Activity", "operationId": "startActivity",
        "security": [{ "apiToken": [] }], "x-hark-auth": "api_token", "x-hark-scopes": ["activities:write"],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/StartActivity" },
        "responses": { "201": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/activities/{identifier}": {
      "parameters": [{ "$ref": "#/components/parameters/Identifier" }],
      "get": {
        "tags": ["Live Activities"], "summary": "Get a Live Activity", "operationId": "getActivity",
        "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "x-hark-auth": "session_or_api_token", "x-hark-scopes": ["activities:read"],
        "responses": { "200": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      },
      "patch": {
        "tags": ["Live Activities"], "summary": "Update a Live Activity", "operationId": "updateActivity",
        "security": [{ "apiToken": [] }], "x-hark-auth": "api_token", "x-hark-scopes": ["activities:write"],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/UpdateActivity" },
        "responses": { "200": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/activities/{identifier}/end": {
      "parameters": [{ "$ref": "#/components/parameters/Identifier" }],
      "post": {
        "tags": ["Live Activities"], "summary": "End a Live Activity", "operationId": "endActivity",
        "security": [{ "apiToken": [] }], "x-hark-auth": "api_token", "x-hark-scopes": ["activities:write"],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/EndActivity" },
        "responses": { "200": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/events": {
      "get": {
        "tags": ["Events"], "summary": "List webhook deliveries", "operationId": "listEvents",
        "security": [{ "bearerAuth": [] }, { "sessionCookie": [] }], "x-hark-auth": "session_or_api_token", "x-hark-scopes": ["events:read"],
        "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }],
        "responses": { "200": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/events/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/ID" }],
      "delete": {
        "tags": ["Events"], "summary": "Delete a webhook delivery", "operationId": "deleteEvent",
        "security": [{ "sessionBearer": [] }, { "sessionCookie": [] }], "x-hark-auth": "session",
        "responses": { "204": { "description": "Event deleted." }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/history": {
      "get": {
        "tags": ["History"], "summary": "List unified account history", "operationId": "listHistory",
        "security": [{ "sessionBearer": [] }, { "sessionCookie": [] }], "x-hark-auth": "session",
        "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/Kind" }],
        "responses": { "200": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/history/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/HistoryID" }],
      "delete": {
        "tags": ["History"], "summary": "Delete one history entry", "operationId": "deleteHistoryItem",
        "security": [{ "sessionBearer": [] }, { "sessionCookie": [] }], "x-hark-auth": "session",
        "responses": { "204": { "description": "History item deleted." }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/hooks/{token}": {
      "parameters": [{ "$ref": "#/components/parameters/WebhookToken" }],
      "post": {
        "tags": ["Webhooks"], "summary": "Send a webhook notification or question", "operationId": "sendWebhook",
        "security": [], "x-hark-auth": "webhook_token_in_path",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/Webhook" },
        "responses": { "201": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/hooks/{token}/events/{event_id}": {
      "parameters": [{ "$ref": "#/components/parameters/WebhookToken" }, { "$ref": "#/components/parameters/EventID" }],
      "get": {
        "tags": ["Webhooks"], "summary": "Poll a webhook delivery and its response", "operationId": "getWebhookEvent",
        "security": [], "x-hark-auth": "webhook_token_in_path",
        "responses": { "200": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/hooks/{token}/events/{event_id}/cancel": {
      "parameters": [{ "$ref": "#/components/parameters/WebhookToken" }, { "$ref": "#/components/parameters/EventID" }],
      "post": {
        "tags": ["Webhooks"], "summary": "Cancel a webhook question", "operationId": "cancelWebhookEvent",
        "security": [], "x-hark-auth": "webhook_token_in_path",
        "responses": { "200": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/hooks/{token}/activities": {
      "parameters": [{ "$ref": "#/components/parameters/WebhookToken" }],
      "post": {
        "tags": ["Webhooks", "Live Activities"], "summary": "Start a service-owned Live Activity", "operationId": "startWebhookActivity",
        "security": [], "x-hark-auth": "webhook_token_in_path",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/StartActivity" },
        "responses": { "201": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/hooks/{token}/activities/{identifier}": {
      "parameters": [{ "$ref": "#/components/parameters/WebhookToken" }, { "$ref": "#/components/parameters/Identifier" }],
      "get": {
        "tags": ["Webhooks", "Live Activities"], "summary": "Get a service-owned Live Activity", "operationId": "getWebhookActivity",
        "security": [], "x-hark-auth": "webhook_token_in_path",
        "responses": { "200": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      },
      "patch": {
        "tags": ["Webhooks", "Live Activities"], "summary": "Update a service-owned Live Activity", "operationId": "updateWebhookActivity",
        "security": [], "x-hark-auth": "webhook_token_in_path",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/UpdateActivity" },
        "responses": { "200": { "$ref": "#/components/responses/JSONDocument" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
