# Copy to .env and fill in. Docker Compose reads .env automatically;
# for `go run` export these yourself (see README).

# ── required ────────────────────────────────────────────────────────────────

# PostgreSQL connection URL. When running under Compose the host is `postgres`.
DATABASE_URL=postgres://hark:hark@localhost:5432/hark?sslmode=disable

# Root secret for every derived encryption and MAC key. At least 32 characters.
# Generate one with: openssl rand -base64 48
# Rotating this invalidates every stored ciphertext and outstanding credential.
HARK_SECRET_KEY=

# ── server ──────────────────────────────────────────────────────────────────

# HARK_ENV=development             # development | production
# HARK_LISTEN_ADDR=:8080
# HARK_PUBLIC_URL=http://localhost:8080
# HARK_LOG_LEVEL=info              # debug | info | warn | error
# HARK_LOG_FORMAT=text             # text | json (defaults to json in production)
# HARK_SHUTDOWN_TIMEOUT=20s
# HARK_MAX_REQUEST_BYTES=65536

# ── account ─────────────────────────────────────────────────────────────────
# Hark is single-user: the one account is seeded at boot from these values.
# There is no sign-up endpoint. Without a password no account is created and
# nobody can sign in; you can also provision one later with `harkd create-user`.
# 12-256 characters, no composition rules.

# HARK_ADMIN_USERNAME=admin
HARK_ADMIN_PASSWORD=
# HARK_ADMIN_EMAIL=admin@hark.local

# ── database pool ───────────────────────────────────────────────────────────

# HARK_DB_MAX_CONNS=10
# HARK_DB_MIN_CONNS=0
# HARK_DB_CONNECT_TIMEOUT=10s
# HARK_DB_MAX_CONN_LIFETIME=1h
# HARK_DB_MAX_CONN_IDLE_TIME=30m
# HARK_DB_AUTO_MIGRATE=true

# ── Apple Push Notification service ─────────────────────────────────────────
# Set all three or none. Without them the server runs but delivers nothing.

# HARK_APNS_KEY_ID=
# HARK_APNS_TEAM_ID=
# HARK_APNS_PRIVATE_KEY=           # PEM text, PEM with \n escapes, or base64 of either
# HARK_APNS_PRIVATE_KEY_FILE=      # alternative: path to the .p8 file
# HARK_APNS_BUNDLE_ID=dev.abdeen.hark
# HARK_APNS_ENVIRONMENT=sandbox    # sandbox | production

# ── limits ──────────────────────────────────────────────────────────────────

# Name the header your reverse proxy overwrites with the real client address.
# Leave unset behind no proxy: per-client rate limiting is then disabled rather
# than keyed off a header a client can forge.
# HARK_TRUSTED_CLIENT_IP_HEADER=

# HARK_RATE_LIMIT_REQUESTER_PER_MINUTE=300
# HARK_RATE_LIMIT_ACCOUNT_PER_MINUTE=1500

# ── Compose only ────────────────────────────────────────────────────────────

# POSTGRES_USER=hark
# POSTGRES_PASSWORD=hark
# POSTGRES_DB=hark
# HARK_PORT=8080
